<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Threat Intelligence Platform | Operations</title>
  <link rel="stylesheet" href="style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .vt-panel {
      padding: 20px 20px 8px;
      border: 1px solid rgba(84, 176, 255, 0.28);
      background: linear-gradient(180deg, rgba(18, 30, 44, 0.9), rgba(9, 18, 28, 0.9));
      box-shadow: 0 0 0 1px rgba(76, 189, 255, 0.08), 0 0 22px rgba(36, 169, 255, 0.12);
    }

    .vt-command-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 10px 8px 8px;
      border-radius: 999px;
      background: rgba(7, 13, 20, 0.92);
      border: 1px solid rgba(85, 170, 255, 0.38);
      box-shadow: inset 0 0 0 1px rgba(84, 176, 255, 0.08), 0 0 18px rgba(64, 160, 255, 0.12);
    }

    .vt-command-bar:focus-within {
      border-color: rgba(95, 214, 255, 0.9);
      box-shadow: 0 0 0 1px rgba(95, 214, 255, 0.28), 0 0 22px rgba(95, 214, 255, 0.22);
    }

    .vt-prefix-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(35, 64, 123, 0.95);
      color: #d7ebff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      border: 1px solid rgba(115, 166, 255, 0.38);
      white-space: nowrap;
    }

    .vt-scan-input {
      flex: 1;
      min-width: 0;
      background: transparent;
      border: none;
      color: #edf7ff;
      font-size: 15px;
      padding: 12px 8px;
      outline: none;
      font-family: var(--font-mono);
    }

    .vt-scan-input::placeholder {
      color: rgba(194, 211, 227, 0.56);
    }

    .vt-scan-btn,
    .vt-refresh-btn,
    .vt-report-btn,
    .vt-official-btn,
    .vt-modal-close {
      font: 600 14px var(--font-sans);
      border-radius: 12px;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    }

    .vt-scan-btn {
      border: none;
      background: linear-gradient(180deg, #78d8ff, #4bb9ff);
      color: #04131d;
      padding: 12px 20px;
      font-weight: 700;
      min-width: 110px;
      box-shadow: 0 8px 18px rgba(75, 185, 255, 0.28);
    }

    .vt-scan-btn:disabled {
      opacity: 0.7;
      cursor: wait;
    }

    .vt-scan-btn:hover:not(:disabled),
    .vt-refresh-btn:hover,
    .vt-report-btn:hover,
    .vt-official-btn:hover,
    .vt-modal-close:hover {
      transform: translateY(-1px);
    }

    .vt-scan-btn.loading {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .vt-spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(7, 19, 29, 0.4);
      border-top-color: rgba(7, 19, 29, 0.9);
      border-radius: 50%;
      animation: vt-spin 0.8s linear infinite;
      display: inline-block;
    }

    @keyframes vt-spin {
      to { transform: rotate(360deg); }
    }

    .vt-scan-result {
      margin-top: 18px;
      min-height: 64px;
    }

    .vt-result-card {
      border: 1px solid rgba(95, 178, 255, 0.34);
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(11, 24, 32, 0.9), rgba(9, 17, 27, 0.9));
      padding: 18px 20px;
      box-shadow: inset 0 0 0 1px rgba(87, 164, 255, 0.08), 0 0 18px rgba(64, 171, 255, 0.09);
    }

    .vt-result-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .vt-result-target {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-white);
      word-break: break-all;
    }

    .vt-verdict-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border: 1px solid transparent;
    }

    .vt-verdict-pill.success {
      background: rgba(27, 120, 74, 0.18);
      color: #7ce8b5;
      border-color: rgba(76, 209, 146, 0.32);
    }

    .vt-verdict-pill.warn {
      background: rgba(168, 126, 22, 0.18);
      color: #f8d77a;
      border-color: rgba(255, 205, 94, 0.28);
    }

    .vt-verdict-pill.danger {
      background: rgba(163, 39, 55, 0.18);
      color: #ff9ca9;
      border-color: rgba(255, 116, 140, 0.28);
    }

    .vt-meta-row {
      margin-top: 10px;
      color: var(--text-secondary);
      font-size: 13px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .vt-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .vt-report-btn,
    .vt-official-btn {
      padding: 10px 14px;
      border: 1px solid transparent;
      font-weight: 700;
    }

    .vt-report-btn {
      background: rgba(71, 195, 255, 0.14);
      color: #78dfff;
      border-color: rgba(96, 208, 255, 0.28);
    }

    .vt-official-btn {
      background: transparent;
      color: var(--text-primary);
      border-color: rgba(159, 199, 234, 0.22);
    }

    .vt-recent-panel {
      margin-top: 20px;
    }

    .vt-recent-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 10px;
      padding: 2px 4px;
    }

    .vt-recent-header h3 {
      margin: 0;
      font-size: 18px;
      color: var(--text-white);
      font-weight: 800;
    }

    .vt-refresh-btn {
      background: rgba(26, 35, 48, 0.92);
      color: var(--text-primary);
      border: 1px solid rgba(160, 188, 206, 0.12);
      padding: 8px 12px;
    }

    .vt-table-wrap {
      overflow: auto;
      border-radius: 12px;
      border: 1px solid rgba(180, 195, 214, 0.08);
    }

    .vt-recent-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 780px;
    }

    .vt-recent-table th,
    .vt-recent-table td {
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid rgba(180, 195, 214, 0.08);
    }

    .vt-recent-table th {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      background: rgba(17, 24, 35, 0.8);
      font-weight: 700;
    }

    .vt-recent-table tbody tr {
      cursor: pointer;
      transition: background 0.15s ease, box-shadow 0.15s ease;
    }

    .vt-recent-table tbody tr:hover {
      background: rgba(96, 208, 255, 0.06);
      box-shadow: inset 0 0 0 1px rgba(96, 208, 255, 0.08);
    }

    .vt-row-indicator {
      font-family: var(--font-mono);
      color: var(--text-white);
      font-weight: 600;
      word-break: break-all;
    }

    .vt-type-pill,
    .vt-verdict-tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border: 1px solid rgba(153, 184, 215, 0.12);
    }

    .vt-type-pill {
      background: rgba(59, 92, 129, 0.14);
      color: #d9ebff;
    }

    .vt-verdict-tag.success {
      background: rgba(27, 120, 74, 0.18);
      color: #7ce8b5;
    }

    .vt-verdict-tag.warn {
      background: rgba(168, 126, 22, 0.18);
      color: #f8d77a;
    }

    .vt-verdict-tag.danger {
      background: rgba(163, 39, 55, 0.18);
      color: #ff9ca9;
    }

    .vt-empty-row {
      text-align: center;
      padding: 18px;
      color: var(--text-muted);
    }

    .vt-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(6, 11, 18, 0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 200;
      padding: 24px;
    }

    .vt-modal-backdrop.hidden {
      display: none;
    }

    .vt-modal-panel {
      width: min(920px, 94vw);
      max-height: 82vh;
      overflow: hidden;
      border-radius: 18px;
      border: 1px solid rgba(112, 164, 255, 0.2);
      background: rgba(9, 15, 22, 0.96);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    }

    .vt-modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      padding: 18px 22px;
      border-bottom: 1px solid rgba(159, 188, 215, 0.08);
    }

    .vt-modal-eyebrow {
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 10px;
      font-weight: 700;
    }

    .vt-modal-header h3 {
      margin: 6px 0 0;
      color: var(--text-white);
      font-size: 28px;
      font-weight: 800;
    }

    .vt-modal-close {
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 28px;
      line-height: 1;
    }

    .vt-modal-content {
      padding: 18px 22px 22px;
      overflow-y: auto;
      max-height: calc(82vh - 92px);
    }

    .vt-engine-list {
      display: grid;
      gap: 10px;
    }

    .vt-engine-item {
      display: grid;
      grid-template-columns: minmax(160px, 220px) 130px 1fr 110px;
      gap: 12px;
      align-items: center;
      padding: 12px 14px;
      border: 1px solid rgba(149, 177, 211, 0.08);
      border-radius: 12px;
      background: rgba(15, 20, 30, 0.8);
    }

    .vt-engine-name {
      color: var(--text-white);
      font-weight: 700;
      word-break: break-word;
    }

    .vt-engine-type {
      color: var(--text-secondary);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .vt-engine-result {
      color: var(--text-primary);
      font-size: 13px;
      line-height: 1.4;
    }

    .vt-engine-method {
      color: var(--text-muted);
      font-size: 11px;
      text-align: right;
    }

    @media (max-width: 720px) {
      .vt-command-bar {
        flex-wrap: wrap;
        border-radius: 18px;
      }

      .vt-scan-btn {
        width: 100%;
      }

      .vt-engine-item {
        grid-template-columns: 1fr;
        align-items: flex-start;
      }

      .vt-engine-method {
        text-align: left;
      }
    }
  </style>
</head>
<body>
  <div class="aegis-app">
    <!-- LEFT SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="brand-crest">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div class="brand-info">
          <h2>Threat Intelligence Platform</h2>
        </div>
      </div>

      <div class="nav-section-title">INTELLIGENCE OPERATIONS</div>
      <nav class="sidebar-nav">
        <button class="nav-link active" data-view="feed">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          <span>Live Threat Stream</span>
        </button>
        <button class="nav-link" data-view="threats">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>
          <span>Top Threats</span>
        </button>
        <button class="nav-link" data-view="reports">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
          <span>Report Corpus</span>
        </button>
        <button class="nav-link" data-view="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <span>Search &amp; Enrich</span>
        </button>
        <button class="nav-link" data-view="cross">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="12" r="6"/><circle cx="15" cy="12" r="6"/></svg>
          <span>Cross-Source Analysis</span>
        </button>
      </nav>

      <div class="nav-section-title" style="margin-top: 24px;">SYSTEM MONITORING</div>
      <nav class="sidebar-nav">
        <button class="nav-link highlight" data-view="cache">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          <span>Lab 7.2: Working Set</span>
        </button>
      </nav>
    </aside>

    <!-- MAIN COMMAND CANVAS -->
    <div class="main-canvas">
      <!-- VIEW PANELS CONTAINER -->
      <div class="content-body">

        <!-- VIEW 1: THREAT STREAM -->
        <section id="view-feed" class="content-view active">
          <header class="view-header">
            <div>
              <span class="eyebrow">INTELLIGENCE OPERATIONS / LIVE</span>
              <h1>Live Threat Stream</h1>
              <p>Normalized indicators and threat activity from trusted intelligence feeds.</p>
            </div>
            <div class="feed-status">
              <span class="live-indicator"><span class="live-dot"></span>Live intelligence</span>
              <span id="last-sync-status" class="feed-sync-status" aria-live="polite">Feed sync status loading...</span>
            </div>
          </header>
          <div class="filter-strip">
            <div class="filter-pills">
              <button class="pill active" data-source="">All Feeds</button>
              <button class="pill" data-source="misp">All MISP</button>
              <button class="pill" data-source="circl">CIRCL</button>
              <button class="pill" data-source="botvrij">Botvrij</button>
              <button class="pill" data-source="threatfox">ThreatFox</button>
              <button class="pill" data-source="virustotal">VirusTotal</button>
            </div>
            <div class="filter-counter" id="feed-counter" aria-live="polite">Loading event count...</div>
          </div>
          <div class="cards-stream" id="events-stream">
            <!-- Dynamic Event Cards -->
            <div class="loading-state">Streaming intelligence records...</div>
          </div>
          <nav class="pagination" id="feed-pagination" aria-label="Threat stream pages" hidden>
            <button class="pagination-button" id="feed-previous" type="button">Previous</button>
            <span class="pagination-status" id="feed-page-status" aria-live="polite"></span>
            <button class="pagination-button" id="feed-next" type="button">Next</button>
          </nav>
        </section>

        <!-- VIEW 2: TOP THREATS -->
        <section id="view-threats" class="content-view">
          <header class="view-header">
            <div>
              <span class="eyebrow">INTELLIGENCE OPERATIONS</span>
              <h1>Top Threats</h1>
              <p>Most recent threat indicators received from configured intelligence sources.</p>
            </div>
            <span class="tag-badge cyan">Live sources</span>
          </header>
          <div class="matrix-grid" id="threats-matrix">
            <!-- Dynamic Threat Cards -->
          </div>
        </section>

        <!-- VIEW 3: REPORT CORPUS -->
        <section id="view-reports" class="content-view">
          <header class="view-header">
            <div>
              <span class="eyebrow">INTELLIGENCE OPERATIONS</span>
              <h1>Report Corpus</h1>
              <p>Research reports and source provenance for the intelligence feed.</p>
            </div>
          </header>
          <div class="corpus-grid">
            <div class="glass-panel">
              <div class="panel-header">
                <h3>Annual Security Reports</h3>
                <span class="tag-badge">awesome-annual-security-reports</span>
              </div>
              <div class="table-container">
                <table id="corpus-table">
                  <thead>
                    <tr>
                      <th>Document</th>
                      <th>Vendor</th>
                      <th>Year</th>
                      <th>Passages</th>
                      <th>Threats Cited</th>
                      <th>PDF Link</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>

            <div class="glass-panel" style="margin-top: 24px;">
              <div class="panel-header">
                <h3>Intelligence Feed Ingestion Sources</h3>
                <span class="tag-badge green">Provenance Rated</span>
              </div>
              <div class="table-container">
                <table id="sources-table">
                  <thead>
                    <tr>
                      <th>Source</th>
                      <th>Records</th>
                      <th>Indicators</th>
                      <th>Latest record</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- VIEW 4: SEARCH & ENRICH -->
        <section id="view-search" class="content-view">
          <header class="view-header">
            <div>
              <span class="eyebrow">INTELLIGENCE OPERATIONS / VIRUSTOTAL</span>
              <h1>VirusTotal scan</h1>
              <p>Check one IP address, domain, URL or file hash against more than 90 antivirus engines. Each result is saved for 24 hours and linked to the threats it belongs to, so the next lookup is instant.</p>
            </div>
          </header>

          <div class="glass-panel vt-panel">
            <div class="vt-command-bar" id="vt-scan-form">
              <span class="vt-prefix-badge">vt scan</span>
              <input id="vt-scan-input" class="vt-scan-input" type="text" placeholder="185.220.101.1  |  evil.example  |  https://...  |  sha256" aria-label="VirusTotal scan target">
              <button id="vt-scan-button" class="vt-scan-btn" type="button">Scan</button>
            </div>
            <div id="vt-scan-result"></div>
          </div>

          <div class="glass-panel vt-recent-panel">
            <div class="vt-recent-header">
              <h3>Recent scans · <span id="vt-cache-count">0 cached</span></h3>
              <button id="vt-refresh" class="vt-refresh-btn" type="button">↻ Refresh</button>
            </div>
            <div class="vt-table-wrap">
              <table class="vt-recent-table">
                <thead>
                  <tr>
                    <th>INDICATOR</th>
                    <th>TYPE</th>
                    <th>VERDICT</th>
                    <th>COUNTRY</th>
                    <th>OWNER</th>
                    <th>SCANNED</th>
                  </tr>
                </thead>
                <tbody id="vt-recent-body"></tbody>
              </table>
            </div>
          </div>
        </section>

        <div id="vt-modal-backdrop" class="vt-modal-backdrop hidden" aria-hidden="true">
          <div class="vt-modal-panel" role="dialog" aria-modal="true" aria-labelledby="vt-modal-title">
            <div class="vt-modal-header">
              <div>
                <div class="vt-modal-eyebrow">VirusTotal analysis</div>
                <h3 id="vt-modal-title">Full report</h3>
              </div>
              <button id="vt-modal-close" class="vt-modal-close" type="button" aria-label="Close report">×</button>
            </div>
            <div id="vt-modal-content" class="vt-modal-content"></div>
          </div>
        </div>

        <!-- CROSS-SOURCE ANALYSIS (separate from duplicate detection) -->
        <section id="view-cross" class="content-view">
          <header class="view-header">
            <div>
              <span class="eyebrow">INTELLIGENCE OPERATIONS</span>
              <h1>Cross-Source Analysis</h1>
              <p>Find intelligence that appears across multiple CTI sources. This is not duplicate detection: two different records can share the same CVE, malware or indicator.</p>
            </div>
            <button id="cs-refresh" class="btn-glow" type="button">Refresh Analysis</button>
          </header>
          <div id="cs-status" class="cs-status"></div>
          <div id="cs-totals" class="cs-cards"></div>
          <div class="glass-panel">
            <div class="panel-header"><h3>Source overlap</h3></div>
            <div id="cs-overlap"></div>
          </div>
          <div class="glass-panel" style="margin-top:20px;">
            <div class="panel-header"><h3>Compare sources</h3></div>
            <div class="search-row">
              <select id="cs-a" aria-label="Source 1"></select>
              <select id="cs-b" aria-label="Source 2"></select>
              <button id="cs-compare" class="btn-glow" type="button">Compare</button>
            </div>
            <div id="cs-compare-result"></div>
          </div>
          <div class="glass-panel" style="margin-top:20px;">
            <div class="panel-header"><h3 id="cs-common-title">Common data</h3></div>
            <div class="filter-pills" id="cs-cat">
              <button class="pill active" data-v="all">All</button><button class="pill" data-v="cve">CVE</button>
              <button class="pill" data-v="malware">Malware</button><button class="pill" data-v="actor">Actor</button>
              <button class="pill" data-v="ioc">Indicator</button><button class="pill" data-v="tool">Tool</button>
              <button class="pill" data-v="galaxy">Other cluster</button>
            </div>
            <div class="filter-pills" id="cs-min" style="margin-top:8px;">
              <button class="pill active" data-v="2">2+ sources</button><button class="pill" data-v="3">3+ sources</button>
              <button class="pill" data-v="4">4+ sources</button>
            </div>
            <div class="search-row" style="margin-top:8px;">
              <select id="cs-src" aria-label="Source filter"></select>
              <input id="cs-q" type="text" placeholder="Search common intelligence..." aria-label="Search common intelligence">
              <select id="cs-sort" aria-label="Sort">
                <option value="source_count">Sort: sources</option><option value="record_count">Sort: records</option>
                <option value="value">Sort: name</option><option value="type">Sort: type</option>
              </select>
            </div>
            <table class="cs-table"><thead><tr><th>Type</th><th>Value</th><th>Found in</th><th>Sources</th><th>Records</th><th>Match</th><th></th></tr></thead>
              <tbody id="cs-rows"></tbody></table>
            <div class="cs-pager"><button id="cs-prev" class="pill">Previous</button><span id="cs-page"></span><button id="cs-next" class="pill">Next</button></div>
          </div>
        </section>

        <!-- LAB 7.2: WORKING SET & WIREDTIGER CACHE -->
        <section id="view-cache" class="content-view">
          <header class="view-header">
            <div>
              <span class="eyebrow">LAB 7.2 / STORAGE ENGINE ANALYSIS</span>
              <h1>Working Set &amp; WiredTiger Cache Analysis</h1>
              <p>Measure a real-record-derived working set, monitor live cache behavior, and benchmark random point reads.</p>
            </div>
          </header>

          <div class="glass-panel lab-objective">
            <div>
              <span class="eyebrow">OBJECTIVE</span>
              <p>Evaluate how working-set size affects WiredTiger cache residency, random-read latency, and disk page reads.</p>
            </div>
            <span class="tag-badge cyan">100,000 derived benchmark documents</span>
          </div>

          <!-- Live collection and cache measurements -->
          <div class="stats-row">
            <div class="stat-card prime">
              <div class="card-icon">📦</div>
              <div class="stat-data">
                <span class="label">Threat Reports</span>
                <span class="big-val" id="ws-document-count">Loading...</span>
                <span class="hint" id="ws-document-size">Collection measurements loading</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="card-icon">💾</div>
              <div class="stat-data">
                <span class="label">Working Set Footprint</span>
                <span class="big-val" id="ws-footprint">Loading...</span>
                <span class="hint">BSON data plus collection indexes</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="card-icon">🧠</div>
              <div class="stat-data">
                <span class="label">WiredTiger Cache In Use</span>
                <span class="big-val" id="wt-bytes-cache">Waiting...</span>
                <span class="hint" id="wt-cache-pct">Waiting for telemetry...</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="card-icon">📈</div>
              <div class="stat-data">
                <span class="label">Cache Hit Ratio (10s)</span>
                <span class="big-val" id="wt-hit-ratio">Waiting...</span>
                <span class="hint">1 − (pages read ÷ pages requested)</span>
              </div>
            </div>
          </div>

          <div class="glass-panel cache-capacity-panel">
            <div class="panel-header">
              <div>
                <h3>Cache Capacity &amp; Eviction Activity</h3>
                <p class="panel-sub">Values come from live MongoDB serverStatus. Reference run: 1,024 MB cache; this instance uses its configured capacity.</p>
              </div>
              <span class="tag-badge" id="wt-cache-capacity">Cache limit: loading...</span>
            </div>
            <div class="cache-detail-grid">
              <div><span class="label">Dirty bytes</span><strong id="wt-dirty">Waiting...</strong></div>
              <div><span class="label">Application-thread evictions</span><strong id="wt-evictions">Waiting...</strong></div>
              <div><span class="label">Pages read into cache</span><strong id="wt-pages-read">Waiting...</strong></div>
            </div>
            <div class="cache-progress" role="progressbar" aria-label="WiredTiger cache utilization" aria-valuemin="0" aria-valuemax="100">
              <div id="wt-cache-progress"></div>
            </div>
          </div>

          <!-- Live cache utilization chart -->
          <div class="glass-panel" style="margin-top: 20px;">
            <div class="panel-header">
              <div>
                <h3>WiredTiger Cache Utilization</h3>
                <p class="panel-sub">Cache bytes in use versus the configured maximum, sampled every 10 seconds.</p>
              </div>
              <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Live 10s Sampling</span>
              </div>
            </div>
            <div class="chart-viewport">
              <canvas id="wt-cache-chart" role="img" aria-label="WiredTiger cache utilization over time"></canvas>
            </div>
          </div>

          <div class="glass-panel random-read-panel">
            <div class="panel-header">
              <div>
                <h3>Random Point-Read Experiment</h3>
                <p class="panel-sub">Run 500 random indexed lookups by <code>_id</code> and measure elapsed time and cache page-read deltas.</p>
              </div>
              <button id="btn-run-random-reads" class="btn-glow" type="button">Run 500 Random Reads</button>
            </div>
            <div class="benchmark-results-box">
              <div class="bench-metric-card">
                <div class="metric-title">Average Read Latency</div>
                <div class="metric-number speed" id="ws-read-latency">—</div>
                <div class="metric-details" id="ws-read-count">No experiment run yet</div>
              </div>
              <div class="bench-metric-card">
                <div class="metric-title">Cache Page Reads / Evictions</div>
                <div class="metric-number" id="ws-read-pages">—</div>
                <div class="metric-details" id="ws-read-pages-detail">Measured during the last workload</div>
              </div>
            </div>
            <p class="experiment-note" id="ws-experiment-status" aria-live="polite">Run the experiment to record measurements from this database instance.</p>
          </div>

        </section>

      </div>
    </div>

    <!-- DETAIL SLIDE-OVER DRAWER -->
    <div id="drawer-backdrop" class="drawer-backdrop hidden">
      <div class="drawer-panel">
        <div class="drawer-header">
          <div class="drawer-title-group">
            <span class="tag-badge cyan" id="drawer-type">THREAT PROFILE</span>
            <h2 id="drawer-title">Adversary Name</h2>
          </div>
          <button id="drawer-close" class="drawer-close-btn">&times;</button>
        </div>
        <div class="drawer-body" id="drawer-content">
          <!-- Dynamic details content -->
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
  <script src="/config.js"></script>
  <script src="app.js"></script>
  <script src="cross-source.js"></script>
</body>
</html>
