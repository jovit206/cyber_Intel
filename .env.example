# Copy to .env (never commit .env). Every value below is a safe placeholder or default.
# Used by docker-compose.yml and read by the backend at run time; nothing here is baked into the image.

# ---- Docker image -----------------------------------------------------------------------------
# After the image is published, set this to its Docker Hub name, e.g. yourname/lab7-threat-intel:v1.0.0
# APP_IMAGE=lab7-threat-intel:v1.0.0

# ---- Application ------------------------------------------------------------------------------
# Host port for the web UI / API.
# APP_PORT=8000
# Database that holds the Lab 7 collections.
MONGO_DATABASE=chapter07
CHAPTER14_WORKER_IMAGE=aegis-chapter14-backup-worker:local
CH14_ALERT_WEBHOOK_SECRET=
# Optional Chapter 16 services. Use the Chapter 16 integration Compose override and keep passwords
# in .env only. The backend reads these credentials server-side; the browser never receives them.
# CHAPTER16_MONGO_URI=mongodb://mongo16:27017
# CHAPTER16_MONGO_DATABASE=fraud_detection
# CHAPTER16_CASSANDRA_HOSTS=cassandra16
# CHAPTER16_CASSANDRA_PORT=9042
# CHAPTER16_CASSANDRA_USERNAME=
# CHAPTER16_CASSANDRA_PASSWORD=
# CHAPTER16_NEO4J_URI=bolt://neo4j16:7687
# CHAPTER16_NEO4J_USERNAME=neo4j
# CHAPTER16_NEO4J_PASSWORD=
# CHAPTER16_NEO4J_DATABASE=neo4j

# Optional VirusTotal enrichment. Leave empty to run without it (public MISP feeds need no key).
# A VirusTotal API key is exactly 64 hexadecimal characters. Do not wrap it in quotes.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_POLL_INTERVAL_SECONDS=900

# Browser origins allowed to call the API, and an optional separate API URL for the frontend.
FRONTEND_ORIGIN=http://localhost:8000
FRONTEND_API_URL=

# ---- LLM provider (server-side only) ---------------------------------------------------------
# New installations prefer local Ollama. The optional Docker overlay will provide the `ollama`
# service hostname; for a host-managed Ollama instance, set OLLAMA_BASE_URL accordingly.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=90
# Optional local Chapter 17 embeddings. Install chapter-17/requirements-vector-lab.txt and place
# all-MiniLM-L6-v2 weights in the local model cache before enabling; API requests never download it.
# RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Legacy Chapter 17 OpenAI-compatible settings remain supported. When LLM_PROVIDER is omitted,
# existing RAG_LLM_API_URL / RAG_LLM_API_KEY / OPENAI_API_KEY settings select this provider.
# LLM_PROVIDER=openai-compatible
# RAG_LLM_API_URL=https://api.openai.com/v1/chat/completions
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_LLM_API_KEY=

# Public-source sync limits (kept small so the first start is quick).
# SYNC_STARTUP_MAX_EVENTS=25
# SYNC_STARTUP_MAX_REPORTS=2

# ---- MongoDB replica set (compose) ------------------------------------------------------------
# WiredTiger cache per member, in GB. Keeps three members light on a laptop.
# MONGO_CACHE_GB=1
# Loopback-only host ports for the members (change only on a port conflict).
# MONGO1_BIND=127.0.0.1:27017
# MONGO2_BIND=127.0.0.1:27018
# MONGO3_BIND=127.0.0.1:27019

# ---- Running outside Docker (python -m uvicorn ...) -------------------------------------------
# MONGO_URI=mongodb://localhost:27017
