# Copy to .env (never commit .env). Every value below is a safe placeholder or default.
# Used by docker-compose.yml and read by the backend at run time; nothing here is baked into the image.

# ---- Docker image -----------------------------------------------------------------------------
# After the image is published, set this to its Docker Hub name, e.g. yourname/lab7-threat-intel:v1.0.0
# APP_IMAGE=lab7-threat-intel:v1.0.0

# ---- Application ------------------------------------------------------------------------------
# Host port for the web UI / API.
# APP_PORT=8000
# Database that holds the Lab 7 collections.
MONGO_DATABASE=chapter07

# Optional VirusTotal enrichment. Leave empty to run without it (public MISP feeds need no key).
# A VirusTotal API key is exactly 64 hexadecimal characters. Do not wrap it in quotes.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_POLL_INTERVAL_SECONDS=900

# Browser origins allowed to call the API, and an optional separate API URL for the frontend.
FRONTEND_ORIGIN=http://localhost:8000
FRONTEND_API_URL=

# Public-source sync limits (kept small so the first start is quick).
# SYNC_STARTUP_MAX_EVENTS=25
# SYNC_STARTUP_MAX_REPORTS=2

# ---- MongoDB replica set (compose) ------------------------------------------------------------
# WiredTiger cache per member, in GB. Keeps three members light on a laptop.
# MONGO_CACHE_GB=1
# Loopback-only host ports for the members (change only on a port conflict).
# MONGO1_BIND=127.0.0.1:27017
# MONGO2_BIND=127.0.0.1:27018
# MONGO3_BIND=127.0.0.1:27019

# ---- Running outside Docker (python -m uvicorn ...) -------------------------------------------
# MONGO_URI=mongodb://localhost:27017
