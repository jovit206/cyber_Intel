MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=chapter07

# Optional reputation enrichment. The public MISP feeds and Galaxy files do
# not require credentials. The 15-minute minimum is within VirusTotal's free
# rate limit (at most 96 scheduled lookups per day).
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_POLL_INTERVAL_SECONDS=900

# Comma-separated browser origins permitted to call the API.
FRONTEND_ORIGIN=http://localhost:3000
# Optional. Blank means same-origin; for a separate frontend, e.g. http://localhost:8000.
FRONTEND_API_URL=

# Optional override for the annual security reports GitHub tree used by the Lab 7.2 monitor.
# GITHUB_REPORT_TREE_URL=https://api.github.com/repos/jacobdjwilson/awesome-annual-security-reports/git/trees/main?recursive=1
