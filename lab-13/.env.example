# Copy to .env and replace both values with independent random hex strings:
#   openssl rand -hex 32
# Use only hexadecimal characters so the values are safe in MongoDB URIs.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
MONGO_EXPORTER_USERNAME=metrics
MONGO_EXPORTER_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTERS

# Optional Prometheus and Grafana profile. Set a unique Grafana username and password
# in the ignored lab-13/.env before starting the observability profile.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_BIND_PORT=19090
GRAFANA_BIND_PORT=13000
