apiVersion: v1
kind: Secret
metadata:
  name: mongo-keyfile
  namespace: mongo-ha
type: Opaque
stringData:
  keyfile: "REPLACE_WITH_A_GENERATED_KEYFILE; do not commit a real key"
---
apiVersion: v1
kind: Secret
metadata:
  name: mongo-credentials
  namespace: mongo-ha
type: Opaque
stringData:
  username: "REPLACE_WITH_MONGO_INITDB_ROOT_USERNAME"
  password: "REPLACE_WITH_MONGO_INITDB_ROOT_PASSWORD"
