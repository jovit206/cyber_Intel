  "queries": [
    {
      "id": "Q1",
      "label": "Electronics, cheapest 20 first",
      "filter": {
        "category": "Electronics"
      },
      "sort": [
        [
          "price",
          1
        ]
      ],
      "limit": 20
    },
    {
      "id": "Q2",
      "label": "Price between $100 and $150",
      "filter": {
        "price": {
          "$gte": 100,
          "$lte": 150
        }
      }
    },
    {
      "id": "Q3",
      "label": "Tagged 'wireless'",
      "filter": {
        "tags": "wireless"
      }
    },
    {
      "id": "Q4",
      "label": "Text search name: 'headphones'",
      "filter": {
        "$text": {
          "$search": "headphones"
        }
      },
      "fallback": {
        "name": {
          "$regex": "headphones",
          "$options": "i"
        }
      }
    },
    {
      "id": "Q5",
      "label": "Books rated >= 4.5, by price",
      "filter": {
        "category": "Books",
        "rating": {
          "$gte": 4.5
        }
      },
      "sort": [
        [
          "price",
          1
        ]
      ]
    }
  ],
  "indexes": [
    {
      "name": "idx_category_price_rating",
      "key": {
        "category": 1,
        "price": 1,
        "rating": 1
      },
      "serves": "Q1 (prefix), Q5 (ESR)"
    },
    {
      "name": "idx_price",
      "key": {
        "price": 1
      },
      "serves": "Q2"
    },
    {
      "name": "idx_tags",
      "key": {
        "tags": 1
      },
      "serves": "Q3 (multikey)"
    },
    {
      "name": "idx_name_text",
      "key": {
        "name": "text"
      },
      "serves": "Q4"
    }
  ],
