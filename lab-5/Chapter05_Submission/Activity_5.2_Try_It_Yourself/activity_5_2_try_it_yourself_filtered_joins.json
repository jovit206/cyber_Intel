  "pipeline_2_plain_join_comparison": {
    "pipeline": [
      {
        "$lookup": {
          "from": "product_orders",
          "localField": "product_id",
          "foreignField": "product_id",
          "as": "all_orders"
        }
      },
      {
        "$set": {
          "qualifying_orders": {
            "$filter": {
              "input": "$all_orders",
              "as": "o",
              "cond": {
                "$and": [
                  {
                    "$eq": [
                      "$$o.status",
                      "completed"
                    ]
                  },
                  {
                    "$gte": [
                      "$$o.order_date",
                      {
                        "$date": "2024-01-01T00:00:00Z"
                      }
                    ]
                  },
                  {
                    "$lt": [
                      "$$o.order_date",
                      {
                        "$date": "2024-04-01T00:00:00Z"
                      }
                    ]
                  },
                  {
                    "$gte": [
                      "$$o.quantity",
                      2
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "product_id": 1,
          "name": 1,
          "pulled": {
            "$size": "$all_orders"
          },
          "kept": {
            "$size": "$qualifying_orders"
          }
        }
      },
      {
        "$sort": {
          "pulled": -1
        }
      }
    ],
    "results": [
