                    "$$pid"
                  ]
                },
                "status": "completed"
              }
            },
            {
              "$sort": {
                "quantity": -1
              }
            },
            {
              "$limit": 2
            },
            {
              "$project": {
                "_id": 0,
                "order_id": 1,
                "customer": 1,
                "quantity": 1,
                "line_total": {
                  "$multiply": [
