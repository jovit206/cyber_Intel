{
  "database": "Chapter05",
  "collections": {
    "products": "products",
    "orders": "product_orders"
  },
  "foreign_side_filter": {
    "status": "completed",
    "order_date": {
      "$gte": {
        "$date": "2024-01-01T00:00:00Z"
      },
      "$lt": {
        "$date": "2024-04-01T00:00:00Z"
      }
    },
    "quantity": {
      "$gte": 2
    }
  },
  "pipeline_1_subpipeline_join": {
    "pipeline": [
      {
        "$lookup": {
          "from": "product_orders",
          "let": {
            "pid": "$product_id",
            "price": "$base_price"
          },
          "pipeline": [
            {
              "$match": {
                "$expr": {
                  "$eq": [
                    "$product_id",
                    "$$pid"
                  ]
                },
                "status": "completed",
                "order_date": {
                  "$gte": {
                    "$date": "2024-01-01T00:00:00Z"
                  },
                  "$lt": {
                    "$date": "2024-04-01T00:00:00Z"
                  }
                },
                "quantity": {
                  "$gte": 2
                }
              }
            },
            {
              "$project": {
                "_id": 0,
                "order_id": 1,
                "customer": 1,
                "quantity": 1,
                "order_date": {
                  "$dateToString": {
                    "format": "%Y-%m-%d",
                    "date": "$order_date"
                  }
                },
                "line_total": {
                  "$multiply": [
                    "$quantity",
                    "$$price"
                  ]
                }
              }
            },
            {
              "$sort": {
                "order_date": 1
              }
            }
          ],
          "as": "qualifying_orders"
        }
      },
      {
        "$match": {
          "qualifying_orders": {
            "$ne": []
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "product_id": 1,
          "name": 1,
          "category": 1,
          "base_price": 1,
          "qualifying_orders": 1,
          "matched": {
            "$size": "$qualifying_orders"
          },
          "revenue": {
            "$sum": "$qualifying_orders.line_total"
          }
        }
      },
      {
        "$sort": {
          "revenue": -1
        }
      }
    ],
    "results": [
