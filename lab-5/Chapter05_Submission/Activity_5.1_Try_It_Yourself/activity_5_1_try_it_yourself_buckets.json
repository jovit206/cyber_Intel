{
  "database": "Chapter05",
  "collection": "orders",
  "orders_in_collection": 20,
  "boundaries": [
    0,
    50,
    200
  ],
  "default_bucket": "large",
  "pipeline": [
    {
      "$set": {
        "order_total": {
          "$multiply": [
            "$quantity",
            "$unit_price"
          ]
        }
      }
    },
    {
      "$bucket": {
        "groupBy": "$order_total",
        "boundaries": [
          0,
          50,
          200
        ],
        "default": "large",
        "output": {
          "count": {
            "$sum": 1
          },
          "revenue": {
            "$sum": "$order_total"
          },
          "avg_order_value": {
            "$avg": "$order_total"
          },
          "units": {
            "$sum": "$quantity"
          },
          "orders": {
            "$push": {
              "order_id": "$order_id",
              "customer": "$customer",
              "product": "$product",
              "qty": "$quantity",
              "total": "$order_total"
            }
          }
        }
      }
    }
  ],
