# Copy to .env in this folder (git-ignored) and fill in YOUR OWN values. Never commit real credentials.

# MongoDB in Docker - the jovit-lab02-mongo container (mongo:7.0) published on 127.0.0.1:27028
#   docker run -d --name jovit-lab02-mongo -p 127.0.0.1:27028:27017 -v jovit-lab02-data:/data/db mongo:7.0 --wiredTigerCacheSizeGB 0.25
MONGO_URI_DOCKER=mongodb://localhost:27028

# MongoDB installed natively as a Windows service
MONGO_URI_NATIVE=mongodb://localhost:27017

# MongoDB Atlas (optional). Atlas -> Database -> Connect -> Drivers -> Python. Leave empty to skip Atlas checks.
# Example shape only:  mongodb+srv://<your-user>:<your-password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI_ATLAS=
