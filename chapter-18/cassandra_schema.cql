CREATE KEYSPACE IF NOT EXISTS threat_intel_lab18
WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};

CREATE TABLE IF NOT EXISTS threat_intel_lab18.threats_by_id (
    threat_id text PRIMARY KEY,
    source text,
    from_source text,
    threat_type text,
    indicator text,
    target text,
    timestamp timestamp,
    severity text,
    confidence double,
    status text,
    description text,
    related_threats list<text>,
    transaction_ids list<text>,
    source_reference text,
    latitude double,
    longitude double,
    country_code text,
    geolocation_source text,
    provenance text
);

CREATE TABLE IF NOT EXISTS threat_intel_lab18.threats_by_source (
    from_source text,
    day_bucket date,
    shard tinyint,
    timestamp timestamp,
    threat_id text,
    source text,
    threat_type text,
    indicator text,
    target text,
    severity text,
    confidence double,
    status text,
    description text,
    related_threats list<text>,
    transaction_ids list<text>,
    source_reference text,
    latitude double,
    longitude double,
    country_code text,
    geolocation_source text,
    provenance text,
    PRIMARY KEY ((from_source, day_bucket, shard), timestamp, threat_id)
) WITH CLUSTERING ORDER BY (timestamp DESC, threat_id ASC);

CREATE TABLE IF NOT EXISTS threat_intel_lab18.threats_by_type (
    threat_type text,
    day_bucket date,
    shard tinyint,
    timestamp timestamp,
    threat_id text,
    source text,
    from_source text,
    indicator text,
    target text,
    severity text,
    confidence double,
    status text,
    description text,
    related_threats list<text>,
    transaction_ids list<text>,
    source_reference text,
    latitude double,
    longitude double,
    country_code text,
    geolocation_source text,
    provenance text,
    PRIMARY KEY ((threat_type, day_bucket, shard), timestamp, threat_id)
) WITH CLUSTERING ORDER BY (timestamp DESC, threat_id ASC);

CREATE TABLE IF NOT EXISTS threat_intel_lab18.threats_by_target (
    target text,
    day_bucket date,
    shard tinyint,
    timestamp timestamp,
    threat_id text,
    source text,
    from_source text,
    threat_type text,
    indicator text,
    severity text,
    confidence double,
    status text,
    description text,
    related_threats list<text>,
    transaction_ids list<text>,
    source_reference text,
    latitude double,
    longitude double,
    country_code text,
    geolocation_source text,
    provenance text,
    PRIMARY KEY ((target, day_bucket, shard), timestamp, threat_id)
) WITH CLUSTERING ORDER BY (timestamp DESC, threat_id ASC);

CREATE TABLE IF NOT EXISTS threat_intel_lab18.threats_by_indicator (
    indicator text,
    day_bucket date,
    shard tinyint,
    timestamp timestamp,
    threat_id text,
    source text,
    from_source text,
    threat_type text,
    target text,
    severity text,
    confidence double,
    status text,
    description text,
    related_threats list<text>,
    transaction_ids list<text>,
    source_reference text,
    latitude double,
    longitude double,
    country_code text,
    geolocation_source text,
    provenance text,
    PRIMARY KEY ((indicator, day_bucket, shard), timestamp, threat_id)
) WITH CLUSTERING ORDER BY (timestamp DESC, threat_id ASC);

CREATE TABLE IF NOT EXISTS threat_intel_lab18.threats_by_day (
    day_bucket date,
    shard tinyint,
    timestamp timestamp,
    threat_id text,
    source text,
    from_source text,
    threat_type text,
    indicator text,
    target text,
    severity text,
    confidence double,
    status text,
    description text,
    related_threats list<text>,
    transaction_ids list<text>,
    source_reference text,
    latitude double,
    longitude double,
    country_code text,
    geolocation_source text,
    provenance text,
    PRIMARY KEY ((day_bucket, shard), timestamp, threat_id)
) WITH CLUSTERING ORDER BY (timestamp DESC, threat_id ASC);
