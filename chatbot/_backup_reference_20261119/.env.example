# REFERENCE ONLY - environment variables read by the AI Threat Assistant code (placeholders, no real secrets).
# The running application reads its own configuration; nothing in this folder is loaded by it.

# --- MongoDB --------------------------------------------------------------------------------------
# Must be a REPLICA SET (sign-in/registration use multi-document transactions).
# From Windows to the original rs0 containers (no auth on this machine): connect directly to the PRIMARY port.
MONGO_URI=mongodb://127.0.0.1:37019/?directConnection=true
# Inside Docker on the fresh-mongo-net network:
# MONGO_URI=mongodb://fresh-mongo1:27017,fresh-mongo2:27017,fresh-mongo3:27017/?replicaSet=rs0
# With credentials (placeholder shape only):
# MONGO_URI=mongodb://<user>:<password>@<host>:<port>/?replicaSet=<set>&authSource=admin
MONGO_DATABASE=chapter07          # users, sessions and threat-intelligence records (attributes, events ...)

# --- LLM (Ollama) ---------------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434        # running directly on Windows
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # running inside a Docker container
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=180
# OLLAMA_API_KEY=<only for Ollama Cloud>

# --- Optional alternative providers (not used by the current deployment) --------------------------
# LLM_PROVIDER=openai-compatible
# RAG_LLM_API_URL=https://api.openai.com/v1/chat/completions
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_LLM_API_KEY=<your key>

# --- Web ------------------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:8000
FRONTEND_API_URL=
SESSION_COOKIE_SECURE=false

# --- Optional: local Windows security agent (local_agent/) ----------------------------------------
# LOCAL_AGENT_URL=http://127.0.0.1:8765
# LOCAL_AGENT_TOKEN=<contents of %LOCALAPPDATA%\AegisLocalAgent\agent_token.txt>
# LOCAL_AGENT_ALLOWED_EMAILS=<comma-separated account emails allowed to request scans>
