# Copy to .env (never commit it) and set values for YOUR environment. Used by docker compose (env_file) or
# `docker run --env-file .env`. Placeholders only - no real credentials.

# ---- MongoDB (required) - must be a REPLICA SET: account registration and sign-in use transactions ----
# Bundled empty replica set (docker compose --profile local-mongo):
MONGO_URI=mongodb://chatbot-mongo:27017/?replicaSet=rs0
# Your own cluster, examples (placeholder shape):
# MONGO_URI=mongodb://<user>:<password>@<host1>:27017,<host2>:27017/?replicaSet=<set>&authSource=admin
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# A replica set on the Docker host, member reachable directly (single primary port):
# MONGO_URI=mongodb://host.docker.internal:<primary-port>/?directConnection=true
MONGO_DATABASE=chapter07     # accounts, sessions and (if present) threat-intelligence collections
# Conversation history always goes to the database "rag_demo" on the same cluster.

# ---- LLM: Ollama on the host machine (required) ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=180
# OLLAMA_API_KEY=<only for Ollama Cloud>
# OLLAMA_MAX_TOKENS=256
# OLLAMA_NUM_CTX=4096

# ---- Optional OpenAI-compatible provider instead of Ollama ----
# LLM_PROVIDER=openai-compatible
# RAG_LLM_API_URL=https://api.openai.com/v1/chat/completions
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_LLM_API_KEY=<your key>

# ---- Web ----
CHATBOT_PORT=8000                    # host port used by docker compose
FRONTEND_ORIGIN=http://localhost:8000
FRONTEND_API_URL=
SESSION_COOKIE_SECURE=false          # set true behind HTTPS

# ---- Optional: local Windows security agent (see the original project's local_agent/) ----
# LOCAL_AGENT_URL=http://host.docker.internal:8765
# LOCAL_AGENT_TOKEN=<agent token>
# LOCAL_AGENT_ALLOWED_EMAILS=<comma-separated emails>
