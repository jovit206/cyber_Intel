# Reference placeholders only. The scripts read process environment variables;
# they do not parse dotenv files. Set values in PowerShell without committing them.
MONGO_URI=mongodb://username:password@localhost:27017/?authSource=admin
MONGODB_ALERT_WEBHOOK_URL=
MONGODB_ALERT_WEBHOOK_PLATFORM=slack

# Optional Docker fallback when mongodump/mongorestore are not installed on Windows.
MONGODB_TOOLS_DOCKER_IMAGE=mongo:7.0.45
MONGODB_TOOLS_DOCKER_NETWORK=chapter13-mongo-net
# If the Python process uses a host-mapped URI, set the Docker-network URI separately.
# MONGODB_TOOLS_URI=mongodb://username:password@mongo1:27017,mongo2:27017,mongo3:27017/admin?replicaSet=rs0&authSource=admin
